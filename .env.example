# CloudForge API Gateway
CLOUDFORGE_HOST=127.0.0.1
CLOUDFORGE_PORT=8080
CLOUDFORGE_DATABASE_MAX_CONNECTIONS=5
RUST_LOG=info

# Required only for the one-time first-admin bootstrap endpoint.
# Generate a fresh value with: openssl rand -hex 32
# CLOUDFORGE_BOOTSTRAP_TOKEN=replace-with-a-random-64-character-hex-value

# Optional for API-only mode. Required for instance persistence.
DATABASE_URL=postgres://cloudforge:cloudforge-dev-only@127.0.0.1:5432/cloudforge

# Development only; change this before exposing any service.
POSTGRES_PASSWORD=cloudforge-dev-only
